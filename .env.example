# Copy this file to .env and fill in your API keys
# cp .env.example .env

# Required: DeepSeek API key (for text washing, name generation, JSON inference)
# Get yours at: https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# Optional: OpenAI API key
OPENAI_API_KEY=sk-xxx

# Optional: Anthropic API key
ANTHROPIC_API_KEY=sk-ant-xxx

# Required for image washing: MuleRouter API key
# Get yours at: https://mulerouter.ai
MULEROUTER_API_KEY=sk-mr-your-mulerouter-key-here
